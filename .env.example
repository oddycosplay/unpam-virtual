# Server
HOST=0.0.0.0
API_PORT=3001
DB_PATH=./data/unpam.db

# Rahasia (diisi otomatis oleh scripts/ensure-env.mjs saat .env belum ada)
JWT_SECRET=
# 32 byte hex untuk enkripsi AES-256-GCM API key provider
ENCRYPTION_KEY=

# LLM provider default. Bisa ditimpa dari panel admin.
# LLM_PROVIDER: anthropic | openai-compatible
LLM_PROVIDER=anthropic
# Kosongkan untuk Claude API resmi. Contoh lain:
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
